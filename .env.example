# ==============================================================================
# e-comm Centralized Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as required:
#   cp .env.example .env
# ==============================================================================

# Project Name
PROJECT_NAME=e-comm

# ------------------------------------------------------------------------------
# Service Exposed Ports
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
PRODUCT_SERVICE_PORT=8081
CUSTOMER_APP_PORT=4200
ADMIN_APP_PORT=4201
MYSQL_PORT=3306
KAFKA_HOST_PORT=9092
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
PHPMYADMIN_PORT=8085

# ------------------------------------------------------------------------------
# MySQL 8 Database Configuration
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=product_db
MYSQL_USER=ecomm_user
MYSQL_PASSWORD=ecomm_password

# Spring Boot Datasource (Product Microservice)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/product_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=ecomm_user
SPRING_DATASOURCE_PASSWORD=ecomm_password

# ------------------------------------------------------------------------------
# phpMyAdmin Database GUI
# ------------------------------------------------------------------------------
PMA_HOST=mysql
PMA_PORT=3306
PMA_USER=ecomm_user
PMA_PASSWORD=ecomm_password

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft Mode)
# ------------------------------------------------------------------------------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,PLAINTEXT_HOST://0.0.0.0:9092,CONTROLLER://0.0.0.0:29093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_LOG_DIRS=/var/lib/kafka/data
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ------------------------------------------------------------------------------
# Redis Cache & Ephemeral Store
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Elasticsearch
# ------------------------------------------------------------------------------
discovery.type=single-node
xpack.security.enabled=false
ES_JAVA_OPTS=-Xms512m -Xmx512m
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200

# ------------------------------------------------------------------------------
# Clerk Cloud Identity & Access Management (IAM)
# (Get keys from https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_ISSUER_URI=https://clerk.e-comm.local
CLERK_JWKS_URL=https://clerk.e-comm.local/.well-known/jwks.json
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=https://clerk.e-comm.local/.well-known/jwks.json

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / Google Login
# (Get keys from https://console.cloud.google.com/apis/credentials)
# Used for Google Sign-In button on Customer Storefront and Admin Portal
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# ------------------------------------------------------------------------------
# Twilio SMS Delivery OTP Verification
# (Get keys from https://console.twilio.com)
# Set TWILIO_ENABLED=true to send real SMS OTPs on package dispatch
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_demo_mock_account_sid
TWILIO_AUTH_TOKEN=mock_auth_token
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_ENABLED=false

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway
# (Get keys from https://dashboard.razorpay.com/app/keys)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder

# ------------------------------------------------------------------------------
# Internal Microservice Routing
# ------------------------------------------------------------------------------
PRODUCT_SERVICE_URL=http://product-service:8081
